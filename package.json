{
  "name": "volta-negotiator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Volta: Realtime voice agent that takes a freight mandate from the client over a real phone call (Twilio) and negotiates it with carriers.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "setup:twilio": "tsx scripts/setup-twilio.ts",
    "test:stream": "node scripts/fake-twilio.mjs",
    "typecheck": "tsc --noEmit",
    "check:email": "tsx scripts/check-email.ts",
    "test:email": "tsx src/email/_recap.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.3.0",
    "twilio": "^6.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
