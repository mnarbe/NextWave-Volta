# --- OpenAI ---
# API key con acceso a la Realtime API.
OPENAI_API_KEY=sk-...
# Modelo de voz en tiempo real. Ajustar al nombre vigente en tu cuenta.
OPENAI_REALTIME_MODEL=gpt-realtime

# --- Twilio ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Número Twilio DESDE el que sale la llamada (formato E.164).
TWILIO_FROM_NUMBER=+521...

# --- Red / servidor ---
# Host público por el que Twilio alcanza tus webhooks y el WebSocket.
# En desarrollo: el dominio que te da ngrok (SIN https://), ej: abc123.ngrok.app
PUBLIC_HOST=tu-subdominio.ngrok.app
PORT=3000
