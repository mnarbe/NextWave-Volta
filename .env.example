# --- OpenAI Realtime --------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
PORT=3000

# --- Twilio (teléfono) ------------------------------------------------------
# Console > Account Info. El auth token es un secreto: no se commitea.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# El número de Volta, en E.164.
TWILIO_NUMBER=+15856011456

# URL pública por la que Twilio nos alcanza (el túnel de ngrok, o el deploy).
# `npm run setup:twilio` la detecta sola del ngrok que esté corriendo y la
# escribe acá.
PUBLIC_URL=https://tu-tunel.ngrok-free.dev

# Poner en 0 solo para probar los webhooks a mano con curl (saltea la
# verificación de la firma X-Twilio-Signature).
TWILIO_VALIDATE_SIGNATURE=1

# --- Firebase / Firestore (opcional) --------------------------------------
# Espeja a Firestore lo que se genera al final de cada llamada: el mandato
# capturado (colección "mandates") y la negociación cerrada (colección
# "negotiations", un doc por callId). Sin esto el server corre igual, solo
# que no exporta.
# Service account (Consola de Firebase > Configuración > Cuentas de servicio >
# Generar nueva clave privada). Usar UNA de las dos formas:
#   - el JSON entero en una línea:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#   - o la ruta al archivo de la clave:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Opcional: si no está, se toma project_id del service account.
# FIREBASE_PROJECT_ID=mi-proyecto

# Phone that plays the carrier in the demo. After an intake Volta rings back
# whoever called; this is the fallback when it could not learn their number.
DEMO_CARRIER_NUMBER=+54...

# OPTIONAL second Twilio number. Calls to it are treated as carriers calling in.
# TWILIO_CARRIER_NUMBER=+1585...
