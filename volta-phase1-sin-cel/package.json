{
  "name": "volta-phase1-sin-cel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Volta: agente de voz que atiende y hace llamadas reales por Twilio (con fallback por navegador).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "setup:twilio": "tsx scripts/setup-twilio.ts",
    "typecheck": "tsc --noEmit",
    "test:stream": "node scripts/fake-twilio.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "twilio": "^6.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
