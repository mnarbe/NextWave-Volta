# --- OpenAI (obligatorio) ----------------------------------------------------
OPENAI_API_KEY=sk-...
# Modelo Realtime. Ajustar al nombre vigente en tu cuenta.
OPENAI_REALTIME_MODEL=gpt-realtime
PORT=3000

# Zona horaria en la que se interpretan las fechas del mandato que vienen sin
# zona explícita (México = UTC-6). Si no la ponés, "08:00" se interpretaría en
# la hora local del server y la ventana de pickup se corre.
MANDATE_TZ_OFFSET=-06:00

# --- Twilio (opcional) -------------------------------------------------------
# Sin estas variables el server arranca igual y funciona el modo navegador.
# Con las cuatro se habilitan las llamadas entrantes y salientes.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# El número comprado en Twilio, en formato E.164.
TWILIO_PHONE_NUMBER=+1...
# URL pública HTTPS del server (ngrok en desarrollo). Sin barra final.
# Configurá el webhook de voz del número apuntando a $PUBLIC_BASE_URL/twilio/inbound
PUBLIC_BASE_URL=https://tu-dominio.ngrok-free.app

# Validación de firma de Twilio. Apagada por defecto: detrás de proxies el host
# firmado y el que ve Express no siempre coinciden y rompe llamadas en vivo.
TWILIO_VALIDATE_SIGNATURE=false
